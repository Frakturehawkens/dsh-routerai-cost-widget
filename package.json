{
  "name": "routerai-cost-widget",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "DeepSeek Harness plugin: a composer-dock pill showing the cheapest RouterAI provider for the active model and what this session has cost so far.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "routerai",
    "cost",
    "pricing"
  ],
  "author": "Frakturehawkens",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Frakturehawkens/dsh-routerai-cost-widget.git"
  },
  "homepage": "https://github.com/Frakturehawkens/dsh-routerai-cost-widget#readme",
  "bugs": {
    "url": "https://github.com/Frakturehawkens/dsh-routerai-cost-widget/issues"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.19"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "lib",
    "locale/*.json",
    "icon.svg",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
